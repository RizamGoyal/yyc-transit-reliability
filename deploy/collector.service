[Unit]
Description=YYC Transit Reliability collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/yyc-transit-reliability
EnvironmentFile=/home/azureuser/yyc-transit-reliability/.env
ExecStart=/home/azureuser/yyc-transit-reliability/.venv/bin/python -m collector.collector
Restart=always
RestartSec=10
# Keep memory use in check on a 1 GB VM
MemoryMax=400M

[Install]
WantedBy=multi-user.target
