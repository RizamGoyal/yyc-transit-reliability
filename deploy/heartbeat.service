[Unit]
Description=YYC transit collector heartbeat (healthchecks.io)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=/home/__USER__/yyc-transit-reliability
EnvironmentFile=/home/__USER__/yyc-transit-reliability/.env
ExecStart=/home/__USER__/yyc-transit-reliability/.venv/bin/python scripts/heartbeat.py
# Exit code 2 = stale data; the /fail ping was already sent, so don't mark the unit failed.
SuccessExitStatus=2
