# Copy to .env and fill in. Never commit .env.
DATA_DIR=data
# Optional: free app token from data.calgary.ca (profile -> developer settings)
CALGARY_APP_TOKEN=
# Polling intervals in seconds
VEHICLE_EVERY=15
TRIP_EVERY=60
ALERT_EVERY=300
# Cloud Storage bucket for nightly backups (name only, no gs://)
BACKUP_BUCKET=
# healthchecks.io ping URLs (from your check's page). Leave empty to disable.
HEALTHCHECK_URL=
BACKUP_HEALTHCHECK_URL=
PROCESS_HEALTHCHECK_URL=
